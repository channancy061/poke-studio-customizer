<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             x:Class="PokeStudio.App.Views.SpeciesPageView"
             x:DataType="vm:SpeciesPageViewModel">
  <Grid ColumnDefinitions="260,*">
    <!-- List -->
    <Border Classes="panel" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Creatures" Classes="heading" Margin="16,16,16,8" />
        <ListBox ItemsSource="{Binding Species}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Creatures">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SpeciesEditorViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Types}" Classes="caption muted" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="pixel" FontSize="11" Foreground="{DynamicResource PL.Text3Brush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Editor -->
    <ScrollViewer Grid.Column="1">
      <ContentControl Content="{Binding Selected}" Margin="28,22">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:SpeciesEditorViewModel">
            <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Name}" Classes="title" FontSize="30" />
                <TextBlock Text="{Binding Number}" Classes="pixel" FontSize="13" Foreground="{DynamicResource PL.Text3Brush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Types}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding TechnicalInfo}" Classes="mono" Foreground="{DynamicResource PL.WarningTextBrush}" IsVisible="{Binding AdvancedMode}" />

              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Text="Base stats" Classes="heading" />
                  <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StatViewModel">
                        <Grid ColumnDefinitions="90,*,64" Margin="0,4">
                          <TextBlock Text="{Binding Label}" FontWeight="Bold" VerticalAlignment="Center" />
                          <Slider Grid.Column="1" Minimum="1" Maximum="255" Value="{Binding Value}" Margin="8,0"
                                  AutomationProperties.Name="{Binding Label}" TickFrequency="1" IsSnapToTickEnabled="True"
                                  ToolTip.Tip="Arrow keys change by 1, Page Up/Down by 10" />
                          <NumericUpDown Grid.Column="2" Value="{Binding Value}" Minimum="1" Maximum="255" Increment="1"
                                         FormatString="0" ShowButtonSpinner="False" Height="34" MinHeight="34" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Stat total" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Total}" Classes="pixel" FontSize="16" Margin="10,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Classes="chip info"><TextBlock Text="{Binding Tier}" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" /></Border>
                  </Grid>
                  <ProgressBar Value="{Binding TotalPercent}" Maximum="100" Height="10" AutomationProperties.Name="Stat total" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Name" Classes="heading" />
                  <TextBox Text="{Binding NameDraft}" MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Creature name" />
                  <TextBlock Text="{Binding NameCounter}" Classes="caption muted" />
                  <TextBlock Text="{Binding NameError}" Classes="caption" Foreground="{DynamicResource PL.ErrorTextBrush}"
                             IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="Dex entry" Classes="heading" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding DexEntry}" TextWrapping="Wrap" Classes="muted" />
                  <TextBlock Text="Types, abilities, items and more arrive with the full Creature editor in Phase 2." Classes="caption muted" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </ScrollViewer>
  </Grid>
</UserControl>
