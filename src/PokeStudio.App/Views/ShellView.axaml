<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             xmlns:c="using:PokeStudio.App.Controls"
             x:Class="PokeStudio.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding Search.OpenCommand}" />
  </UserControl.KeyBindings>

  <Panel>
  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" Height="{StaticResource PL.TopBarHeight}" Padding="12,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="ghost icon" Command="{Binding GoHomeCommand}" ToolTip.Tip="Back to projects" AutomationProperties.Name="Back to projects">
            <Image Source="avares://PokeStudio/Assets/app-icon-256.png" Width="24" Height="24" Classes="pixel" />
          </Button>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ProjectName}" FontWeight="ExtraBold" FontSize="15" />
            <TextBlock Text="{Binding GameTitle}" Classes="caption muted" />
          </StackPanel>
          <Border Classes="chip" Background="{DynamicResource PL.PlatformGbaBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding PlatformLabel}" Classes="pixel" Foreground="White" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <Button Grid.Column="1" Margin="20,0,0,0" Width="420" Classes="quiet" HorizontalContentAlignment="Left"
                Command="{Binding Search.OpenCommand}"
                ToolTip.Tip="Search Pokémon, moves, trainers and places (Ctrl+K)" AutomationProperties.Name="Search">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.Search}" />
            <TextBlock Text="Search Pokémon, moves, trainers…" Foreground="{DynamicResource PL.Text3Brush}" FontWeight="Normal" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ghost icon" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" AutomationProperties.Name="Undo">
            <c:Icon Data="{StaticResource Icon.Undo}" Size="18" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" AutomationProperties.Name="Redo">
            <c:Icon Data="{StaticResource Icon.Redo}" Size="18" />
          </Button>
          <Button Classes="quiet" Command="{Binding ToggleChangesCommand}" ToolTip.Tip="Show or hide the Changes panel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{StaticResource Icon.History}" />
              <TextBlock Text="Changes" />
              <Border Background="{DynamicResource PL.AccentBrush}" CornerRadius="4" Padding="6,0" IsVisible="{Binding IsDirty}">
                <TextBlock Text="{Binding UnsavedCount}" Foreground="{DynamicResource PL.BgBrush}" FontSize="11" FontWeight="ExtraBold" />
              </Border>
            </StackPanel>
          </Button>
          <Button Classes="quiet" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Save}" /><TextBlock Text="Save" /></StackPanel>
          </Button>
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="secondary" Command="{Binding BuildGameCommand}" ToolTip.Tip="Save, back up and build your game">
                <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Build}" /><TextBlock Text="Build" /></StackPanel>
              </Button>
              <Button Classes="primary" Command="{Binding TestGameCommand}" ToolTip.Tip="Open your latest build in your emulator">
                <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Play}" /><TextBlock Text="Test my game" /></StackPanel>
              </Button>
            </StackPanel>
            <Border Classes="tour-ring" Margin="-4" IsVisible="{Binding IsTourActions}" />
          </Panel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Height="{StaticResource PL.StatusBarHeight}" Padding="14,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <c:Icon Data="{StaticResource Icon.Save}" Size="14" Foreground="{DynamicResource PL.WarningTextBrush}" IsVisible="{Binding IsDirty}" />
          <TextBlock Text="{Binding UnsavedText}" Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" VerticalAlignment="Center">
          <c:Icon Data="{StaticResource Icon.Archive}" Size="14" Foreground="{DynamicResource PL.Text2Brush}" />
          <TextBlock Text="{Binding BackupText}" Classes="caption muted" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding Toast}" Classes="caption" Foreground="{DynamicResource PL.SuccessTextBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Side navigation -->
    <Border DockPanel.Dock="Left" Classes="panel" BorderThickness="0,0,1,0" Width="{StaticResource PL.SideNavWidth}" Padding="10,8">
      <Panel>
      <Border Classes="tour-ring" IsVisible="{Binding IsTourNav}" ZIndex="1" />
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding HiddenText}" IsVisible="{Binding HasHidden}" Classes="caption muted" Margin="10,8" TextWrapping="Wrap" />
        <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" AutomationProperties.Name="Modules">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:NavItemViewModel">
              <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Reason}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6">
                <c:Icon Data="{Binding Icon}" Size="18" />
                <StackPanel>
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Text="{Binding Reason}" Classes="caption" IsVisible="{Binding IsLocked}" TextWrapping="Wrap" MaxWidth="160" FontWeight="Normal" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      </Panel>
    </Border>

    <!-- Changes panel -->
    <Border DockPanel.Dock="Right" Classes="panel" BorderThickness="1,0,0,0" Width="{StaticResource PL.ChangesPanelWidth}" IsVisible="{Binding IsChangesOpen}">
      <Panel>
      <Border Classes="tour-ring" IsVisible="{Binding IsTourChanges}" ZIndex="1" />
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="52" Padding="16,0" BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <c:Icon Data="{StaticResource Icon.History}" />
            <TextBlock Text="Changes" Classes="subhead" />
            <TextBlock Text="{Binding UnsavedText}" Classes="caption muted" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,1,0,0">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Save}" /><TextBlock Text="Save · Ctrl S" /></StackPanel>
          </Button>
        </Border>
        <Panel>
          <TextBlock Text="No changes yet. Everything you edit shows up here, and each item can be undone on its own."
                     IsVisible="{Binding !HasChanges}" Classes="small muted" TextWrapping="Wrap" Margin="16" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Changes}" Margin="12">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeItemViewModel">
                  <Border Classes="well" Margin="0,0,0,6" Padding="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Description}" FontWeight="Bold" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock Text="{Binding Area}" Classes="caption muted" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost icon sm" Command="{Binding UndoCommand}"
                              ToolTip.Tip="Undo this change" AutomationProperties.Name="Undo this change">
                        <c:Icon Data="{StaticResource Icon.Undo}" Size="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
      </Panel>
    </Border>

    <!-- Current page -->
    <Panel>
      <ContentControl Content="{Binding CurrentPage}" />
      <Border Classes="tour-ring" Margin="6" IsVisible="{Binding IsTourPage}" />
    </Panel>
  </DockPanel>

  <!-- Global search (Ctrl+K) -->
  <Border Background="{DynamicResource PL.ScrimBrush}" IsVisible="{Binding Search.IsOpen}" PointerPressed="OnSearchScrimPressed">
    <Border Classes="card raised" Width="640" MaxHeight="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0" Padding="0"
            PointerPressed="OnSearchCardPressed">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14" BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,0,0,1">
          <TextBox x:Name="SearchBox" Text="{Binding Search.Query}" Watermark="Search Pokémon, moves and tools…" KeyDown="OnSearchKeyDown"
                   AutomationProperties.Name="Search everything">
            <TextBox.InnerLeftContent>
              <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,0,0" Foreground="{DynamicResource PL.Text3Brush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,1,0,0">
          <TextBlock Text="↑ ↓ to choose · Enter to open · Esc to close" Classes="caption muted" />
        </Border>
        <Panel>
          <TextBlock Text="Nothing matches. Try part of a name, like “char” or “bolt”." Classes="small muted" Margin="16" IsVisible="{Binding Search.HasNoResults}" />
          <ListBox ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Selected}" Background="Transparent" Margin="6"
                   DoubleTapped="OnSearchResultActivated" AutomationProperties.Name="Search results">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchResult">
                <Grid ColumnDefinitions="72,*" Margin="0,2">
                  <Border Classes="chip" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption muted" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>
  </Border>

  <!-- Guided tour -->
  <Panel IsVisible="{Binding IsTourOpen}">
    <Border Classes="card raised" Width="380" Padding="20" BorderBrush="{DynamicResource PL.AccentBrush}" BorderThickness="2"
            HorizontalAlignment="{Binding TourHorizontal}" VerticalAlignment="{Binding TourVertical}" Margin="{Binding TourMargin}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding TourStepText}" Classes="overline" />
          <Button Grid.Column="1" Classes="ghost icon sm" Command="{Binding EndTourCommand}" ToolTip.Tip="End the tour" AutomationProperties.Name="End the tour">
            <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
          </Button>
        </Grid>
        <TextBlock Text="{Binding TourTitle}" Classes="heading" />
        <TextBlock Text="{Binding TourText}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="ghost sm" Content="Skip tour" Command="{Binding EndTourCommand}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet sm" Content="Back" Command="{Binding TourBackCommand}" IsVisible="{Binding !TourIsFirst}" />
            <Button Classes="primary sm" Content="{Binding TourNextText}" Command="{Binding TourNextCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Panel>

  <!-- Check before saving -->
  <Border Background="{DynamicResource PL.ScrimBrush}" IsVisible="{Binding IsValidationOpen}">
    <Border Classes="card raised" Width="760" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,10" Spacing="4">
          <TextBlock Text="{Binding ValidationTitle}" Classes="title" FontSize="22" />
          <TextBlock Text="We checked your changes. Each item says what's wrong and how to fix it." Classes="small muted" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ValidationFooter}" Classes="small muted" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet" Content="Not now" Command="{Binding CloseValidationCommand}" IsCancel="True" />
              <Button Classes="primary" Command="{Binding SaveAnywayCommand}" IsEnabled="{Binding CanSaveAnyway}">
                <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Save}" /><TextBlock Text="Save" /></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Issues}" Margin="24,0,24,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IssueViewModel">
                <Border Classes="well" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="chip error" IsVisible="{Binding IsError}"><TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /></Border>
                        <Border Classes="chip warning" IsVisible="{Binding IsWarning}"><TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="{Binding Text}" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="460" />
                      </StackPanel>
                      <TextBlock Text="{Binding Suggestion}" IsVisible="{Binding HasSuggestion}" Classes="small muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <Button Classes="secondary sm" Content="Fix it for me" Command="{Binding FixCommand}" IsVisible="{Binding HasFix}" />
                      <Button Classes="ghost sm" Content="Take me there" Command="{Binding GoCommand}" IsVisible="{Binding CanGo}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <!-- "Working…" overlay for heavy work: shows what's happening and keeps clicks out until it's done -->
  <Border IsVisible="{Binding IsBusy}" Background="#66000000" ZIndex="100">
    <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="480" Padding="24,20">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" />
        <TextBlock Text="This can take a little while on a big project." Classes="caption muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</UserControl>
