<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             xmlns:m="using:PokeStudio.Core.Models"
             xmlns:c="using:PokeStudio.App.Controls"
             x:Class="PokeStudio.App.Views.MovesPageView"
             x:DataType="vm:MovesPageViewModel">
  <Grid ColumnDefinitions="270,*">
    <Border Classes="panel" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Moves" Classes="heading" />
            <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="caption muted" VerticalAlignment="Center" />
          </Grid>
          <TextBox Text="{Binding Search}" Watermark="Search moves" AutomationProperties.Name="Search moves">
            <TextBox.InnerLeftContent>
              <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,0,0" Foreground="{DynamicResource PL.Text3Brush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter by type">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="m:CatalogEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" AutomationProperties.Name="Move list">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MoveListItem">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Subtitle}" Classes="caption muted" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Power}" Classes="pixel" FontSize="11" Foreground="{DynamicResource PL.Text3Brush}" VerticalAlignment="Center" ToolTip.Tip="Power" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1">
      <ContentControl Content="{Binding Editor}" Margin="28,22" />
    </ScrollViewer>
  </Grid>
</UserControl>
