<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             xmlns:m="using:PokeStudio.Core.Models"
             xmlns:t="using:PokeStudio.Core.Trainers"
             xmlns:c="using:PokeStudio.App.Controls"
             x:Class="PokeStudio.App.Views.EnemyAiPageView"
             x:DataType="vm:EnemyAiPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Enemy AI" Classes="title" />
        <TextBlock Text="How cleverly trainers battle. Pick a setup and give it to many trainers at once; fine-tune single trainers on the Trainers page."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Right now" Classes="heading" />
          <ItemsControl ItemsSource="{Binding Usage}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Give trainers a new AI" Classes="heading" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="Setup" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch" AutomationProperties.Name="AI setup">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="t:AiPreset"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding PresetDescription}" Classes="small muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="For" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" PlaceholderText="Every trainer" HorizontalAlignment="Stretch" AutomationProperties.Name="Which trainers">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ScopeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding ApplyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Ai}" /><TextBlock Text="Apply" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasTuning}">
        <StackPanel Spacing="10">
          <TextBlock Text="AI tuning" Classes="heading" />
          <TextBlock Text="Fine-tune how often the AI switches out or stays in. These settings apply to every trainer in the game (from your project's include/config/ai.h)." Classes="small muted" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Tuning}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AiSettingRowViewModel">
                <Grid ColumnDefinitions="*,220,60" ColumnSpacing="12" Margin="0,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Comment}" Classes="caption muted" TextWrapping="Wrap" FontWeight="Normal" IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Slider Grid.Column="1" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" Classes="pixel" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="What each behaviour does" Classes="heading" />
          <TextBlock Text="From your project's own battle_ai.h." Classes="caption muted" />
          <ItemsControl ItemsSource="{Binding Flags}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:CatalogEntry">
                <Grid ColumnDefinitions="220,*" Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="small muted" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
