<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             x:Class="PokeStudio.App.Views.EncounterPlannerPageView"
             x:DataType="vm:EncounterPlannerPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Plan wild Pokémon" Classes="title" />
        <TextBlock Text="Give every area Pokémon that do well against the next major battles, so players have real answers to the bosses instead of hoping for luck. Water types stay on water, Rock and Ground types in smashed rocks, and every new Pokémon hits a coming boss hard. Neighbouring areas get different families (good for the Nuzlocke dupes clause), legendaries never appear, and levels stay as they were."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="callout info" IsVisible="{Binding NoCaps}">
        <TextBlock Text="This game has no level caps, so the planner can't tell which battles come next. Set the caps on Levels &amp; caps first." TextWrapping="Wrap" />
      </Border>

      <Border Classes="card" IsVisible="{Binding HasCaps}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Replace up to" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Shares}" SelectedItem="{Binding Share}" Width="90" AutomationProperties.Name="Share of each area's Pokémon to replace" />
            <TextBlock Text="% of each area's Pokémon, looking ahead" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Lookaheads}" SelectedItem="{Binding Lookahead}" Width="70" AutomationProperties.Name="Major battles to look ahead" />
            <TextBlock Text="major battles" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="The Pokémon that help least against those battles are replaced first. An area's place in the story comes from its wild levels and the level caps." Classes="caption muted" TextWrapping="Wrap" />
          <Button Classes="primary" Content="Preview" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasCaps}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Route trainers" Classes="heading" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Content="Update route trainers" Command="{Binding RefreshTrainersCommand}" />
          </Grid>
          <TextBlock Text="After planning, ordinary trainers (Youngsters, Bird Keepers, Hikers…) still have the original Pokémon. This gives each of them Pokémon the player can meet in the wild by then, sharing a type with the old ones (a Bird Keeper keeps birds), at the same levels. Moves are level-up moves only, never Sand Attack-style accuracy drops, evasion boosts or one-hit KOs. Gym leaders and other bosses aren't changed here."
                     Classes="small muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasCaps}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Battle check" Classes="heading" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Content="Check every battle" Command="{Binding CheckCommand}" />
          </Grid>
          <TextBlock Text="Goes through the playthrough battle by battle and lists the wild Pokémon a player can catch before each one that hit its main types hard. FireRed and Emerald use their real story order (and when fishing rods, Surf and Rock Smash become available); other games use the wild levels."
                     Classes="small muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CheckSummary}" TextWrapping="Wrap" IsVisible="{Binding CheckSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BattleCheckViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Types}" Classes="caption muted" />
                  <TextBlock Text="{Binding Counters}" Classes="small" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasAreas}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Areas" Classes="heading" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Content="Apply ticked areas" Command="{Binding ApplyCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Areas}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlanAreaViewModel">
                <Border Classes="well">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Bosses}" Classes="caption muted" />
                      <TextBlock Text="{Binding Swaps}" Classes="small" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
