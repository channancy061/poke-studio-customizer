<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PokeStudio.App.Views.ConfirmDialog"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Please confirm">
  <StackPanel>
    <StackPanel Margin="24,20,24,12" Spacing="8">
      <TextBlock x:Name="TitleText" Classes="heading" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" Classes="small muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border BorderBrush="{DynamicResource PL.BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <!-- Cancel is the safe default: it gets focus and answers Esc. -->
        <Button x:Name="CancelButton" Classes="quiet" Content="Cancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" Classes="primary" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
