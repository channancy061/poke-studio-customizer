<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokeStudio.App.ViewModels"
             x:Class="PokeStudio.App.Views.GameOptionsPageView"
             x:DataType="vm:GameOptionsPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Game options" Classes="title" />
        <TextBlock Text="A short menu at the start of a new game. For each option, choose whether the player picks it or you decide it for them."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameOptionRowViewModel">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" Classes="heading" />
                  <TextBlock Text="{Binding Explanation}" Classes="small muted" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Title}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,220" ColumnSpacing="16" DataContext="{Binding Nuzlocke}" x:DataType="vm:GameOptionRowViewModel">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Title}" Classes="heading" />
              <TextBlock Text="{Binding Explanation}" Classes="small muted" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Nuzlocke">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <ItemsControl ItemsSource="{Binding NuzlockeRules}" IsVisible="{Binding NuzlockeShown}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameOptionRowViewModel">
                <Grid ColumnDefinitions="*,220" ColumnSpacing="16" Margin="16,6,0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Explanation}" Classes="small muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <CheckBox IsChecked="{Binding HelperEnabled}" FontWeight="Bold" Content="Pokémon Center helper" />
          <TextBlock Text="Someone in every Pokémon Center who tunes the player's Pokémon. Placed behind the counter next to the nurse when there's room, otherwise on a free tile that blocks nothing. Prices are in Pokémon dollars (0 = free)."
                     Classes="small muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6" IsVisible="{Binding HelperEnabled}">
            <CheckBox IsChecked="{Binding HelperNature}" Content="Change nature (any of the 25)" />
            <NumericUpDown Grid.Column="1" Value="{Binding NaturePrice}" Minimum="0" Maximum="999999" Increment="100" FormatString="0" AutomationProperties.Name="Nature change price" />
            <CheckBox Grid.Row="1" IsChecked="{Binding HelperIvs}" Content="Perfect IVs" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding IvPrice}" Minimum="0" Maximum="999999" Increment="100" FormatString="0" AutomationProperties.Name="Perfect IVs price" />
            <CheckBox Grid.Row="2" IsChecked="{Binding HelperEvs}" Content="EV spreads (Attack + Speed, HP + Defense…, or reset)" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding EvPrice}" Minimum="0" Maximum="999999" Increment="100" FormatString="0" AutomationProperties.Name="EV spread price" />
          </Grid>
          <StackPanel Spacing="6" IsVisible="{Binding HelperEnabled}">
            <CheckBox IsChecked="{Binding HelperRelearn}" Content="Remember moves (free): the game's own move relearner" />
            <CheckBox IsChecked="{Binding HelperForget}" Content="Forget a move, HMs too (free): the game's own Move Deleter" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Change ability" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding HelperAbilityModes}" SelectedItem="{Binding HelperAbilityMode}" MinWidth="240" AutomationProperties.Name="Ability changer">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModeOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6" IsVisible="{Binding HelperAbilityShown}">
              <TextBlock Text="Normal ability price" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding AbilityPrice}" Minimum="0" Maximum="999999" Increment="500" FormatString="0" AutomationProperties.Name="Ability change price" />
              <TextBlock Grid.Row="1" Text="Hidden ability price" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding HiddenAbilityPrice}" Minimum="0" Maximum="999999" Increment="500" FormatString="0" AutomationProperties.Name="Hidden ability price" />
              <TextBlock Grid.Row="2" Text="Hidden abilities after badge (0 = from the start)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding HiddenAbilityBadge}" Minimum="0" Maximum="8" Increment="1" FormatString="0" AutomationProperties.Name="Badge that opens hidden abilities" />
            </Grid>
            <TextBlock Text="Lists the abilities the Pokémon's species has in the game as it is now, so abilities changed in Poke Studio are offered too."
                       Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding HelperAbilityShown}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Bag and PC" Classes="heading" />
          <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
            <TextBlock Text="Different items in the bag's Items pocket (0 = the game's own, 150 = as many as fit)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding BagItemsSlots}" Minimum="0" Maximum="150" Increment="10" FormatString="0" AutomationProperties.Name="Bag Items pocket size" />
            <TextBlock Grid.Row="1" Text="Different items in the PC's item storage (0 = the game's own)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PcItemsSlots}" Minimum="0" Maximum="250" Increment="10" FormatString="0" AutomationProperties.Name="PC item storage size" />
          </Grid>
          <TextBlock Text="FireRed holds 42 different items in the Items pocket, Emerald 30. A bigger Items pocket goes in the save's spare area, and an older save's items move into it the first time it loads. A bigger PC storage needs room in the main save area: FireRed's is full, so leave it at 0 there (the build stops if it doesn't fit)."
                     Classes="small muted" TextWrapping="Wrap" />
          <TextBlock Text="Fixes" Classes="heading" Margin="0,8,0,0" />
          <CheckBox IsChecked="{Binding FixAiSwitchInMemory}" Content="Battle AI forgets the Pokémon that left (otherwise a revealed Levitate makes it skip Earthquake on the next one)" />
          <CheckBox IsChecked="{Binding OneOfEachImportantItem}" Content="FireRed shops sell an important item, like a reusable TM, only once (as Emerald's do)" />
          <CheckBox IsChecked="{Binding DebugMenus}" Content="Debug menus, for testing only (B or R + Start, Select in battle): leave off in a build for players" />
          <CheckBox IsChecked="{Binding QuietNamingWhenPartyFull}" Content="FireRed: with a full party, no &quot;sent to the PC&quot; on the naming screen before the battle asks to add the Pokémon to the party" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <CheckBox IsChecked="{Binding MartSpecialist}" FontWeight="Bold" Content="Mart Specialist" />
          <TextBlock Text="A second person behind every Poké Mart's counter who sells held items (Leftovers, Life Orb, Choice items…), special Poké Balls and TMs at the game's prices. The stock grows with each badge: strong items come later, and a TM is sold once its power is fair for the next boss's level."
                     Classes="small muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding AsksDifficulty}">
        <StackPanel Spacing="8">
          <TextBlock Text="Difficulty menu" Classes="heading" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Starts on" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding DifficultyChoices}" SelectedItem="{Binding DefaultDifficulty}" MinWidth="160" AutomationProperties.Name="Difficulty the menu starts on">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DifficultyChoiceOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <CheckBox IsChecked="{Binding OfferExtraHard}" Content="Offer Extra Hard" />
          <CheckBox IsChecked="{Binding TrainerRulesByDifficulty}" Content="Difficulty changes how trainers behave" />
          <CheckBox IsChecked="{Binding HardChokepoints}" IsEnabled="{Binding TrainerRulesByDifficulty}" Margin="24,0,0,0"
                    Content="Hard and up: route trainers stand where they can't be walked past (only near their own place)" />
          <TextBlock TextWrapping="Wrap" Classes="caption muted"
                     Text="Easy: only important battles stop the player; other trainers battle when talked to. Normal: as the original game. Hard: every trainer sees far and in every direction (no sneaking past), and Gym Leaders wait until every trainer in their Gym is beaten. Extra Hard: as Hard, with six Pokémon per trainer (make those teams on Plan wild Pokémon)." />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding FixedDifficultyShown}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="The difficulty is always" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding DifficultyChoices}" SelectedItem="{Binding FixedDifficulty}" MinWidth="160" AutomationProperties.Name="Fixed difficulty">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DifficultyChoiceOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding NoItemsShown}">
        <CheckBox IsChecked="{Binding NoItemsAlsoWild}" Content="No items in wild battles either" />
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="What the player sees" Classes="heading" />
          <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding WhereText}" Classes="small muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
