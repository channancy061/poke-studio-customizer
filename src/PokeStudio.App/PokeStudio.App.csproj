<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Executable name and avares:// asset root. -->
    <AssemblyName>PokeStudio</AssemblyName>
    <RootNamespace>PokeStudio.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\poke-studio.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Self-contained single-file publish (no .NET install needed). Trimming stays off in Phase 1. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="..\..\samples\Demo Valley.demogame.json" Link="samples\Demo Valley.demogame.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokeStudio.Core\PokeStudio.Core.csproj" />
    <ProjectReference Include="..\PokeStudio.Modules.Demo\PokeStudio.Modules.Demo.csproj" />
    <ProjectReference Include="..\PokeStudio.Modules.Expansion\PokeStudio.Modules.Expansion.csproj" />
    <ProjectReference Include="..\PokeStudio.Modules.Gen3Rom\PokeStudio.Modules.Gen3Rom.csproj" />
    <ProjectReference Include="..\PokeStudio.Modules.Nds\PokeStudio.Modules.Nds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PokeStudio.App.Tests" />
  </ItemGroup>
</Project>
