<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Generated from tokens.json. Theme-aware keys resolve with {DynamicResource}. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PL.BgColor">#13142A</Color>
      <SolidColorBrush x:Key="PL.BgBrush" Color="{StaticResource PL.BgColor}" />
      <Color x:Key="PL.Surface1Color">#1C1E3A</Color>
      <SolidColorBrush x:Key="PL.Surface1Brush" Color="{StaticResource PL.Surface1Color}" />
      <Color x:Key="PL.Surface2Color">#262948</Color>
      <SolidColorBrush x:Key="PL.Surface2Brush" Color="{StaticResource PL.Surface2Color}" />
      <Color x:Key="PL.Surface3Color">#30345A</Color>
      <SolidColorBrush x:Key="PL.Surface3Brush" Color="{StaticResource PL.Surface3Color}" />
      <Color x:Key="PL.BorderColor">#34385E</Color>
      <SolidColorBrush x:Key="PL.BorderBrush" Color="{StaticResource PL.BorderColor}" />
      <Color x:Key="PL.BorderStrongColor">#4A4F7E</Color>
      <SolidColorBrush x:Key="PL.BorderStrongBrush" Color="{StaticResource PL.BorderStrongColor}" />
      <Color x:Key="PL.TextColor">#EEEDFF</Color>
      <SolidColorBrush x:Key="PL.TextBrush" Color="{StaticResource PL.TextColor}" />
      <Color x:Key="PL.Text2Color">#B4B6D9</Color>
      <SolidColorBrush x:Key="PL.Text2Brush" Color="{StaticResource PL.Text2Color}" />
