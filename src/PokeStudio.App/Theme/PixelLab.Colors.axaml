      <Color x:Key="PL.ConsoleBgColor">#0B0C1C</Color>
      <SolidColorBrush x:Key="PL.ConsoleBgBrush" Color="{StaticResource PL.ConsoleBgColor}" />
      <BoxShadows x:Key="PL.Elevation1">0 1 2 0 #66000000</BoxShadows>
      <BoxShadows x:Key="PL.Elevation2">0 6 16 0 #73000000</BoxShadows>
      <BoxShadows x:Key="PL.Elevation3">0 18 48 0 #8C000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
