      <Color x:Key="PL.InfoSoftColor">#172E4D</Color>
      <SolidColorBrush x:Key="PL.InfoSoftBrush" Color="{StaticResource PL.InfoSoftColor}" />
      <Color x:Key="PL.FocusColor">#FFD166</Color>
      <SolidColorBrush x:Key="PL.FocusBrush" Color="{StaticResource PL.FocusColor}" />
      <Color x:Key="PL.ScrimColor">#B8080918</Color>
