      <Color x:Key="PL.WarningTextColor">#FFC46B</Color>
      <SolidColorBrush x:Key="PL.WarningTextBrush" Color="{StaticResource PL.WarningTextColor}" />
      <Color x:Key="PL.WarningSoftColor">#3D2E14</Color>
      <SolidColorBrush x:Key="PL.WarningSoftBrush" Color="{StaticResource PL.WarningSoftColor}" />
      <Color x:Key="PL.ErrorColor">#FF6B6B</Color>
