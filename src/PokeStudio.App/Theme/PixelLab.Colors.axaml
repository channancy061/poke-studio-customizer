  <!-- Platform badges: identical in both themes -->
  <SolidColorBrush x:Key="PL.PlatformGbaBrush" Color="#6D28D9" />
  <SolidColorBrush x:Key="PL.PlatformGbaForegroundBrush" Color="#FFFFFF" />
  <x:String x:Key="PL.PlatformGbaLabel">GBA</x:String>
  <SolidColorBrush x:Key="PL.PlatformNdsBrush" Color="#0E6E8C" />
  <SolidColorBrush x:Key="PL.PlatformNdsForegroundBrush" Color="#FFFFFF" />
  <x:String x:Key="PL.PlatformNdsLabel">NDS</x:String>
  <SolidColorBrush x:Key="PL.Platform3dsBrush" Color="#B42318" />
  <SolidColorBrush x:Key="PL.Platform3dsForegroundBrush" Color="#FFFFFF" />
  <x:String x:Key="PL.Platform3dsLabel">3DS</x:String>

  <!-- Creature types: background + accessible foreground + label (never colour alone) -->
  <SolidColorBrush x:Key="PL.TypeNormalBrush" Color="#A8A77A" />
  <SolidColorBrush x:Key="PL.TypeNormalForegroundBrush" Color="#13142A" />
  <x:String x:Key="PL.TypeNormalLabel">Normal</x:String>
  <SolidColorBrush x:Key="PL.TypeFireBrush" Color="#EE8130" />
  <SolidColorBrush x:Key="PL.TypeFireForegroundBrush" Color="#13142A" />
  <x:String x:Key="PL.TypeFireLabel">Fire</x:String>
