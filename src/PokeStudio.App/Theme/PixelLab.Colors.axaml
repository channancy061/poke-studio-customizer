      <Color x:Key="PL.OnSecondaryColor">#13142A</Color>
      <SolidColorBrush x:Key="PL.OnSecondaryBrush" Color="{StaticResource PL.OnSecondaryColor}" />
      <Color x:Key="PL.AccentColor">#FF7A6B</Color>
      <SolidColorBrush x:Key="PL.AccentBrush" Color="{StaticResource PL.AccentColor}" />
      <Color x:Key="PL.AccentTextColor">#FF9E92</Color>
      <SolidColorBrush x:Key="PL.AccentTextBrush" Color="{StaticResource PL.AccentTextColor}" />
      <Color x:Key="PL.AccentSoftColor">#40191C</Color>
      <SolidColorBrush x:Key="PL.AccentSoftBrush" Color="{StaticResource PL.AccentSoftColor}" />
      <Color x:Key="PL.SuccessColor">#4ADE9A</Color>
