      <SolidColorBrush x:Key="PL.PrimaryBrush" Color="{StaticResource PL.PrimaryColor}" />
      <Color x:Key="PL.PrimaryHoverColor">#B0A4FF</Color>
      <SolidColorBrush x:Key="PL.PrimaryHoverBrush" Color="{StaticResource PL.PrimaryHoverColor}" />
      <Color x:Key="PL.PrimaryPressedColor">#8676F2</Color>
      <SolidColorBrush x:Key="PL.PrimaryPressedBrush" Color="{StaticResource PL.PrimaryPressedColor}" />
      <Color x:Key="PL.PrimarySoftColor">#2E2A5C</Color>
      <SolidColorBrush x:Key="PL.PrimarySoftBrush" Color="{StaticResource PL.PrimarySoftColor}" />
      <Color x:Key="PL.PrimaryTextColor">#C3B9FF</Color>
      <SolidColorBrush x:Key="PL.PrimaryTextBrush" Color="{StaticResource PL.PrimaryTextColor}" />
      <Color x:Key="PL.OnPrimaryColor">#13142A</Color>
      <SolidColorBrush x:Key="PL.OnPrimaryBrush" Color="{StaticResource PL.OnPrimaryColor}" />
      <Color x:Key="PL.SecondaryColor">#3EE6B0</Color>
