<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PokeStudio.App.Controls">

  <Style Selector="c|Icon">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource PL.Text3Brush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PL.Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PL.BorderBrush}" />
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{DynamicResource PL.Surface2Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PL.RadiusLg}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.callout">
    <Setter Property="CornerRadius" Value="{StaticResource PL.RadiusLg}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.callout.info"><Setter Property="Background" Value="{DynamicResource PL.InfoSoftBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource PL.InfoTextBrush}" /></Style>
  <Style Selector="Border.callout.success"><Setter Property="Background" Value="{DynamicResource PL.SuccessSoftBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource PL.SuccessTextBrush}" /></Style>
  <Style Selector="Border.callout.warning"><Setter Property="Background" Value="{DynamicResource PL.WarningSoftBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource PL.WarningTextBrush}" /></Style>
  <Style Selector="Border.callout.error"><Setter Property="Background" Value="{DynamicResource PL.ErrorSoftBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource PL.ErrorTextBrush}" /></Style>

  <Style Selector="Border.pill">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource PL.Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PL.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
